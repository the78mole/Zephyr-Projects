/*
 * Board-Overlay fuer ESP32-S3-DevKitC (procpu)
 * Projekt: 200-BThome-Ranging
 *
 * HC-SR04: TRIG -> GPIO9, ECHO -> GPIO8
 * Power-Gate: GPIOs 4,5,6,7,15,16,17 parallel (~280 mA Kapazitaet)
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/ {
	zephyr,user {
		trig-gpios  = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		echo-gpios  = <&gpio0 8 GPIO_ACTIVE_HIGH>;
		power-gpios = <&gpio0  4 GPIO_ACTIVE_HIGH>,
			      <&gpio0  5 GPIO_ACTIVE_HIGH>,
			      <&gpio0  6 GPIO_ACTIVE_HIGH>,
			      <&gpio0  7 GPIO_ACTIVE_HIGH>,
			      <&gpio0 15 GPIO_ACTIVE_HIGH>,
			      <&gpio0 16 GPIO_ACTIVE_HIGH>,
			      <&gpio0 17 GPIO_ACTIVE_HIGH>;
	};
};
